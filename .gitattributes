# Normalize text files to LF in the repo, but check out with native line endings.
* text=auto

# Windows batch files MUST keep CRLF — they break with LF in cmd.exe
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files — never normalize
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
